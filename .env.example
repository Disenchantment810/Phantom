# Copy this file to .env and adjust. Never commit the real .env.
#
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production (production requires SECRET_KEY)
ENVIRONMENT=development
SECRET_KEY=change-me

# Local-first database (SQLAlchemy URL). SQLite is the MVP default.
DATABASE_URL=sqlite:///./phantom.db

# Hard cap for any single request body (bytes).
MAX_BODY_BYTES=1048576

# Per-upload cap for the code/log workflows (bytes).
UPLOAD_MAX_BYTES=524288

# AI provider. Leave empty to keep AI assistance disabled (default).
# When set together with AI_MODEL and the API key env var, an "AI-assisted
# interpretation" option appears behind an explicit consent checkbox.
AI_PROVIDER=
AI_MODEL=
# NAME of the env var that holds the API key (the key is never stored here):
AI_API_KEY_ENV=AI_API_KEY
# OpenAI-compatible endpoint; point at any compatible service:
AI_BASE_URL=https://api.openai.com/v1
# The API key is read from the environment only and never stored in the DB:
# AI_API_KEY=
